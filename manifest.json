{
  "manifest_version": 3,
  "name": "Refined VTOP - Quick Navigation & Spotlight",
  "version": "2.0.0",
  "description": "Sleek Quick Dock, Ctrl+K Spotlight search, and instant 1-click navigation for VIT VTOP portals.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://vtop.vit.ac.in/*",
    "*://vtop2.vit.ac.in/*",
    "*://vtopcc.vit.ac.in/*",
    "*://vtopbhopal.vit.ac.in/*",
    "*://vtopap.vit.ac.in/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Refined VTOP Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://vtop.vit.ac.in/*",
        "*://vtop2.vit.ac.in/*",
        "*://vtopcc.vit.ac.in/*",
        "*://vtopbhopal.vit.ac.in/*",
        "*://vtopap.vit.ac.in/*"
      ],
      "css": [
        "src/content/content.css"
      ],
      "js": [
        "src/utils/storage.js",
        "src/utils/dom.js",
        "src/modules/stealth-host.js",
        "src/modules/crawler.js",
        "src/modules/menu-drawer.js",
        "src/modules/quick-dock.js",
        "src/modules/command-palette.js",
        "src/content/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "open_palette": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      },
      "description": "Open Refined VTOP Command Palette"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "src/content/content.css"
      ],
      "matches": [
        "*://vtop.vit.ac.in/*",
        "*://vtop2.vit.ac.in/*",
        "*://vtopcc.vit.ac.in/*",
        "*://vtopbhopal.vit.ac.in/*",
        "*://vtopap.vit.ac.in/*"
      ]
    }
  ]
}
